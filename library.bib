  doi = {10.1162/152638001316881395},
  url = {https://doi.org/10.1162/152638001316881395},
  urldate = {2024-05-10},
  abstract = {An increasingly dominant, largely American response to the contemporary environmental crisis understands environmental degradation as the product of individual shortcomings and finds solutions in enlightened, uncoordinated consumer choice. Several forces promote this process of individualization, including the historical baggage of mainstream environmentalism, the core tenets of liberalism, the dynamic ability of capitalism to commodify dissent, and the relatively recent rise of global environmental threats to human prosperity. The result is to narrow our collective ability to imagine and pursue a variety of productive responses to the environmental problems before us. When responsibility for environmental problems is individualized, there is little room to ponder institutions, the nature and exercise of political power, or ways of collectively changing the distribution of power and influence in society. Confronting consumption requires individuals to understand themselves not primarily as consumers but rather as citizens in a participatory democracy, working together to change broader policy and larger social institutions. It also requires linking explorations of consumption to politically charged issues that challenge the political imagination.},
  file = {/home/jules/Zotero/storage/J43LRRF7/Maniates (2001) Individualization Plant a Tree, Buy a Bike, Save.pdf;/home/jules/Zotero/storage/HESCQELS/Individualization-Plant-a-Tree-Buy-a-Bike-Save-the.html}
}


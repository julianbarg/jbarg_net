  title = {The {{Politics}} of {{Learning}} from {{Rare Events}}},
  author = {Rerup, Claus and Zbaracki, Mark J.},
  year = 2021,
  month = feb,
  journal = {Organization Science},
  volume = {32},
  number = {6},
  pages = {1391--1414},

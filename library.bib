@article{Swarup2020,
  title = {Comment on `{{Assessing ExxonMobil}}'s Climate Change Communications (1977--2014)' {{Supran}} and {{Oreskes}} (2017 {{Environ}}. {{Res}}. {{Lett}}. 12 084019)},
  author = {Swarup, V},
  year = 2020,

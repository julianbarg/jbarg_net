@article{Ghobadian2020,
  title = {Examining Legitimatisation of Additive Manufacturing in the Interplay between Innovation, Lean Manufacturing and Sustainability},
  author = {Ghobadian, Abby and Talavera, Irene and Bhattacharya, Arijit and Kumar, Vikas and {Garza-Reyes}, Jose Arturo and O'Regan, Nicholas},
  year = 2020,
  month = jan,
  journal = {International Journal of Production Economics},

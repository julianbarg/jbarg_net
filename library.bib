@article{Mena2016,
  title = {On the {{Forgetting}} of {{Corporate Irresponsibility}}},
  author = {Mena, S{\'e}bastien and Rintam{\"a}ki, Jukka and Fleming, Peter and Spicer, Andr{\'e}},
  year = 2016,

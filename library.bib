  author = {Vaghefi, Saeid Ashraf and Stammbach, Dominik and Muccione, Veruska and Bingler, Julia and Ni, Jingwei and Kraus, Mathias and Allen, Simon and {Colesanti-Senni}, Chiara and Wekhof, Tobias and Schimanski, Tobias and Gostlow, Glen and Yu, Tingyu and Wang, Qian and Webersinke, Nicolas and Huggel, Christian and Leippold, Markus},

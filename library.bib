@article{Cure2020,
  title = {Impression {{Management}} in {{Graphical Representation}} of {{Economic}}, {{Social}}, and {{Environmental Issues}}: {{An Empirical Study}}},
  shorttitle = {Impression {{Management}} in {{Graphical Representation}} of {{Economic}}, {{Social}}, and {{Environmental Issues}}},
  author = {C{\"u}re, Tuvana and Esen, Emel and {\c C}al{\i}{\c s}kan, Arzu {\"O}zs{\"o}zg{\"u}n},
  year = 2020,
  month = jan,

  abstract = {The 2015 Paris Agreement aims to limit warming to 2 or 1.5{$^\circ$}C above preindustrial level, although combined Intended Nationally Determined Contributions (INDCs) are likely insufficient to achieve these targets. We propose a set of idealized emission pathways consistent with the targets. If countries reduce emissions in line with their INDCs, the 2{$^\circ$}C threshold could be avoided only if net zero greenhouse gas emissions (GHGEs) are achieved by 2085 and late century negative emissions are considerably in excess of those assumed in Representative Concentration Pathway (RCP) 2.6 (net -5 Gt CO2/yr, compared with -1.5 Gt CO2/yr in RCP2.6). More aggressive near-term reductions would allow 2{$^\circ$}C to be avoided with less end-of-century carbon removal capacity. A 10\% cut in GHGEs by 2030 (relative to 2015) could likely achieve 2{$^\circ$}C with RCP2.6 level negative emissions. The 1.5{$^\circ$}C target requires GHGEs to be reduced by almost a third by 2030 and net zero by 2050, while a 50 year overshoot of 1.5{$^\circ$}C allows net zero GHGEs by 2060.},
  copyright = {\copyright 2016. The Authors.},
  langid = {english},
  file = {/home/jules/Zotero/storage/E69GKUTQ/Sanderson et al. (2016) What would it take to achieve the Paris temperatur.pdf;/home/jules/Zotero/storage/4E45FWEQ/2016GL069563.html}

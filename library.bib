  shorttitle = {The {{Interaction}} of {{Product-Service Systems}} ({{PSS}}) and {{Corporate Environmental Management}} ({{CEM}})},
  author = {Adam, Marcus and Str{\"a}hle, Jochen and Freise, Matthias},
  year = 2017,

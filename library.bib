@article{Jackson2019,
  title = {Eunice {{Foote}}, {{John Tyndall}} and a Question of Priority},
  author = {Jackson, Roland},
  year = 2019,
  month = feb,
  journal = {Notes and Records: the Royal Society Journal of the History of Science},
  volume = {74},

}

@article{Lie2025,
  title = {The Fine Print of Collaboration: {{How}} Contractual Provisions Govern {{IP}} and Disclosure in Publicly Funded Research},
  shorttitle = {The Fine Print of Collaboration},
  author = {Lie, Haakon Thue and Egelie, Knut J{\o}rgen and Grimpe, Christoph and S{\o}rheim, Roger},
  year = 2025,
  month = dec,
  journal = {Research Policy},

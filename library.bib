@article{Kennedy2013,
  title = {Past Performance and Future Needs for Low Carbon Climate Resilient Infrastructure-- {{An}} Investment Perspective},
  author = {Kennedy, Christopher and {Corfee-Morlot}, Jan},
  year = 2013,
  month = aug,
  journal = {Energy Policy},
  volume = {59},

@article{Chin2008,
  title = {Perceptions of {{Wood}} in {{Rivers}} and {{Challenges}} for {{Stream Restoration}} in the {{United States}}},
  author = {Chin, Anne and Daniels, Melinda D. and Urban, Michael A. and Pi{\'e}gay, Herv{\'e} and Gregory, Kenneth J. and Bigler, Wendy and Butt, Anya Z. and Grable, Judith L. and Gregory, Stanley V. and Lafrenz, Martin and Laurencio, Laura R. and Wohl, Ellen},
  year = 2008,
  journal = {Environmental Management},
  volume = {41},
  number = {6},
  pages = {893--903},
  issn = {0364-152X},
  doi = {10.1007/s00267-008-9075-9},
  url = {http://link.springer.com/10.1007/s00267-008-9075-9},
  abstract = {This article reports a study of the public perception of large wood in rivers and streams in the United States. Large wood is an element of freshwater aquatic ecosystems that has attracted much scientific interest in recent years because of its value in biological and geomorphological processes. At the heart of the issue is the nature of the relationship between scientific recognition of the ecological and geomorphological benefits of wood in rivers, management practices utilizing wood for river remediation progress, and public perceptions of in-channel wood. Surveys of students' perceptions of riverscapes with and without large wood in the states of Colorado, Connecticut, Georgia, Illinois, Iowa, Missouri, Oregon, and Texas suggest that many individuals in the United States adhere to traditionally negative views of wood. Except for students in Oregon, most respondents considered photographs of riverscapes with wood to be less aesthetically pleasing and needing more improvement than rivers without wood. Analysis of reasons given for improvement needs suggest that Oregon students are concerned with improving channels without wood for fauna habitat, whereas respondents elsewhere focused on the need for cleaning wood-rich channels for flood risk management. These results underscore the importance of public education to increase awareness of the geomorphological and ecological significance of wood in stream systems. This awareness should foster more positive attitudes toward wood. An integrated program of research, education, and policy is advocated to bridge the gap between scientific knowledge and public perception for effective management and restoration of river systems with wood. \copyright{} 2008 Springer Science+Business Media, LLC.},
  pmid = {18305987},
  file = {/home/jules/Zotero/storage/IDHWJQQ9/Chin et al. (2008) Perceptions of Wood in Rivers and Challenges for S.pdf}
}


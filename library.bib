  number = {4},
  pages = {1611--1633},
  issn = {0033-5533},
  doi = {10.1162/qjec.2008.123.4.1611},
  abstract = {We examine how incumbents respond to the threat of entry by competitors (as distinct from how they respond to actual entry). We look specifically at passenger airlines, using the evolution of Southwest Airlines' route network to identify particular routes where the probability of future entry rises abruptly. We find that incumbents cut fares significantly when threatened by Southwest's entry. Over half of Southwest's total impact on incumbent fares occurs before Southwest starts flying. These cuts are only on threatened routes, not those out of non-Southwest competing airports. The evidence on whether incumbents are seeking to deter or accommodate entry is mixed.},
  isbn = {0033-5533}

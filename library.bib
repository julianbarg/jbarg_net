@article{Bjorn2021,
  title = {From the {{Paris Agreement}} to Corporate Climate Commitments: Evaluation of Seven Methods for Setting `science-Based' Emission Targets},
  shorttitle = {From the {{Paris Agreement}} to Corporate Climate Commitments},
  author = {Bj{\o}rn, Anders and Lloyd, Shannon and Matthews, Damon},
  year = 2021,

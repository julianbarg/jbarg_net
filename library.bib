  urldate = {2022-05-31},
  abstract = {As companies issue solidarity statements aligning themselves with social justice activism, employees and consumers have started to suffer from ``statement fatigue,'' a feeling that for many companies are attempting to respond to conversations about racial injustice and police brutality without having to change their internal cultures. In response, employees --- and consumers --- have been calling companies out and accusing them of hypocrisy. The authors, who are diversity and inclusion experts, suggest changes that companies can make on the organizational, leadership, and individual levels to show that they are committed to creating a more just and equitable workplace, and aren't simply making a hollow show of solidarity.},

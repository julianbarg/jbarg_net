@article{Zbaracki2004,
  title = {Managerial and {{Customer Costs}} of {{Price Adjustment}}: {{Direct Evidence}} from {{Industrial Markets}}},
  shorttitle = {Managerial and {{Customer Costs}} of {{Price Adjustment}}},
  author = {Zbaracki, Mark J. and Ritson, Mark and Levy, Daniel and Dutta, Shantanu and Bergen, Mark},
  year = 2004,
  month = may,
  journal = {The Review of Economics and Statistics},
  volume = {86},

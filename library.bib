  author = {Sullivan, Bilian Ni and Haunschild, Pamela and Page, Karen},
  year = 2007,
  month = feb,
  journal = {Organization Science},
  volume = {18},
  number = {1},
  pages = {55--70},
  issn = {1047-7039},
  doi = {10.1287/orsc.1060.0229},
  url = {http://pubsonline.informs.org/doi/abs/10.1287/orsc.1060.0229},
  abstract = {In this study, we examine the effects of illegal/unethical acts on\textbackslash ninterfirm networks. We hypothesize that the quality of network partners\textbackslash nwill decline and overall network structure will change after a firm\textbackslash ncommits an unethical act. More specifically, we posit that the decline\textbackslash nin partner quality is primarily driven by higher quality firms leaving\textbackslash nthe network, and the focal firm being forced to replace them with lower\textbackslash nquality ones. We also propose that partner prominence and network\textbackslash ncohesion will be affected after these acts, and that the changes in\textbackslash npartner quality and network structure will be greater for those acts\textbackslash nperceived as more illegitimate. We test these hypotheses using a sample\textbackslash nof 200 large firms in the United States and data on unethical acts by\textbackslash nthese firms. Our results show that the quality of a firm's network\textbackslash npartners declines after the firm's commission of an unethical act, and\textbackslash nthat the deterioration in partner quality tends to be greater for acts\textbackslash nof greater illegitimacy. Our results also show declines in network\textbackslash nprominence and cohesion for firms involved in these activities. We\textbackslash ndiscuss the implications of our results for the literatures on\textbackslash ninterfirm networks and unethical corporate activities.},
  isbn = {1047-7039},
  pmid = {249060200005},
  file = {/home/jules/Zotero/storage/G68VJWP4/Sullivan et al. (2007) Organizations Non Gratae The Impact of Unethical.pdf}
}


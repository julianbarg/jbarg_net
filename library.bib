@article{Herzog-Hawelka2023,
  title = {The Role of (Multi)National Oil and Gas Companies in Leaving Fossil Fuels Underground: {{A}} Systematic Literature Review},
  shorttitle = {The Role of (Multi)National Oil and Gas Companies in Leaving Fossil Fuels Underground},
  author = {{Herzog-Hawelka}, Janina and Gupta, Joyeeta},

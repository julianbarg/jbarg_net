  journal = {International Journal of Greenhouse Gas Control},
  series = {Special {{Issue}} Commemorating the 10th Year Anniversary of the Publication of the {{Intergovernmental Panel}} on {{Climate Change Special Report}} on {{CO2 Capture}} and {{Storage}}},

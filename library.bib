@article{zotero-item-12717,
  title = {Canada's Climate Lobby: Networks of Fossil Dominance and Social-Ecological Advocacy},
  shorttitle = {Canada's Climate Lobby},
  author = {Graham, Nicolas and Chen, David and Sapinski, Jean Philippe and Carroll, William K.},
  year = 2026,
  month = apr,
  journal = {Climatic Change},
  volume = {179},

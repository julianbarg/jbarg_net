@article{Bargb,
  title = {Fossil {{Fuel Ties}} to {{Climate-Relevant Research Centers}} at {{U}}.{{S}}. {{Universities}}},
  author = {Barg, Julian and Supran, Geoffrey},
  abstract = {Universities are an explicit target of the U.S. oil and gas industry's product defense strategy on climate change, yet the scale of fossil fuel interests' infiltration of academia has never been assessed. This paper quantitatively evaluates all publicly disclosed funders of climate change-relevant research centers at four influential U.S. universities since the Paris Agreement. We find that the fossil fuel sector is the dominant corporate funder of climate research centers at Harvard University, the Massachusetts Institute of Technology, and Stanford University. Across these three universities and the University of California, Berkeley, the fossil fuel sector accounts for one-fifth (23\%) of all corporate funders, one-third (35\%) of all corporate funding ties, and two-fifths (42\%) of all corporate funders of high-profile climate change research centers. ExxonMobil, Chevron, Shell, and BP each fund more climate research centers than any other company. The fossil fuel sector's network of funding ties at these four universities rivals the scale and centrality of government, non-profit, and philanthropy funding networks.},
  langid = {english},
  file = {/home/jules/Zotero/storage/3NU7LIQH/Barg and Supran (Fossil Fuel Ties to Climate-Relevant Research Cent.pdf}
}


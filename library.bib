@article{Gifford2026,
  title = {Expert Opinions on Soil Carbon Dioxide Removal},
  author = {Gifford, Lauren and Nawaz, Sara and Morgan, Margaret},
  year = 2026,
  month = aug,
  journal = {Climatic Change},

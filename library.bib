@article{Whitacre2021,
  title = {{{COVID-19}} and the Political Geography of Racialisation: {{Ethnographic}} Cases in {{San Francisco}}, {{Los Angeles}} and {{Detroit}}},
  shorttitle = {{{COVID-19}} and the Political Geography of Racialisation},
  author = {Whitacre, Ryan and {Oni-Orisan}, Adeola and Gaber, Nadia and Martinez, Carlos and Buchbinder, Liza and Herd, Denise and M. Holmes, Seth},
  year = 2021,
  month = sep,
  journal = {Global Public Health},
  volume = {16},

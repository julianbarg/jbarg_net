@article{Craggs2012,
  title = {Towards a Political Geography of Hotels: {{Southern Rhodesia}}, 1958--1962},
  shorttitle = {Towards a Political Geography of Hotels},
  author = {Craggs, Ruth},
  year = 2012,
  month = may,
  journal = {Political Geography},
  volume = {31},

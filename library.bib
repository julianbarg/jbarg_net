  abstract = {The increasing amount of digital data has led to a capability for researchers to better understand human behavior at scale: new methods embedded in the field of Computational Social Science (CSS) have enabled large-scale analysis of trends and patterns: it is now possible to determine with precision the psychology of millions of people, as well as cultural and scientific shifts in society. However, with this increasing amount of data come various challenges such as handling the heterogeneity and the high dimensionality of this type of information makes it difficult to extract insights. In contrast, historical data face issues such as the scarcity of sources, data quality, and data imbalance, which can lead to a skewed vision of the past. Different tools have emerged to tackle these issues; the digitization and semantic-based structuration of historical databases have increased our understanding of the past. Topic modeling algorithms have made it possible to summarize and visualize information from large unstructured datasets to extract temporal trends and deep patterns within information. However, more efforts are required: historical databases must be cleaned, refined, and debiased to effectively extract real patterns. On the other hand, topic modeling algorithms need improvement to avoid spurious patterns and help researchers make better sense of the results. My dissertation aims to address these issues in different ways: first, by re-incorporating theories into large-scale analysis to limit the potential number of directions of analysis that big data can lead to. Second, by adopting a multi-disciplinary approach and integrating tools from fields of ecology (such as the unseen-species model) to de-bias historical trends. Lastly, by improving topic modeling techniques using embeddings and advanced visual representations. The different chapters of my thesis apply these approaches to various use cases, each embedded in distinct theoretical frameworks: Chapter 1 focuses on estimating scientific and cultural activity of humans throughout history. By first de-biasing the data using the unseen-species model, we create an index of cultural production and show that this index correlates with estimates of GDP per capita. Using this newly validated tool, we describe the evolution of standards of living in regions and times not covered by the literature in historical economics. Chapter 2 is centered on the study of scientific curiosity on the long run to understand the impact of psychology on historical trends. Chapter 3 investigates the concept of arousal within the neuroscientific literature using a graph-based topic modeling tool. This chapter evaluates how arousal has been discussed and studied across different subfields of neuroscience, providing insights into the structure of the field. The final chapter introduces ''Bunkatopics'', a topic modeling tool designed to enhance our understanding of large-scale textual datasets. This chapter shows how using advanced topic modeling tools can improve the transparency of datasets used for training Large Language Models (LLMs).},
  school = {Ecole Normale Sup\'erieure de Paris - ENS Paris},
  keywords = {Artificial intelligence,Computational History,Computational social science,Curiosite,Curiosity,Debiaisage,Debiasing,Embedding,Espace latent,Intelligence artificielle,Networks,Reseaux,Science sociales computationnelles,Tendances,Topic Modeling,Trends},
  file = {/home/jules/Zotero/storage/JJ23HDMS/de Dampierre (2024) Using Visual Topic Modeling and Debiasing Techniqu.pdf}
}

@article{Deerwester1990,

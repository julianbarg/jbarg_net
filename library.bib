@article{Brady2026,
  title = {Redesigning Algorithms to Intervene on Social Norm Misperceptions during a National Election},
  author = {Brady, William J. and Doyle, Meriel and Elnakouri, Abdo and Finkel, Eli J. and Jackson, Joshua Conrad and Kteily, Nour and Parker, Victoria and Puryear, Curtis and Spelman, Trevor and Teeny, Jacob and Torres, Mark},
  year = 2026,

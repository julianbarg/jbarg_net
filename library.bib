@article{Calvin2020,
  title = {Global Market and Economic Welfare Implications of Changes in Agricultural Yields Due to Climate Change},
  author = {Calvin, Katherine and Mignone, Bryan K. and Kheshgi, Haroon S. and Snyder, Abigail C. and Patel, Pralit and Wise, Marshall and Clarke, Leon E. and Edmonds, Jae},
  year = 2020,

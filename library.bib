@article{Schoots2020,
  title = {Conflict and Revolt in the Name of Unity: {{Florentine}} Factions in the {{{\emph{Consulte}}}}{\emph{ e }}{{{\emph{Pratiche}}}} on the Cusp of the {{Ciompi Revolt}}},
  shorttitle = {Conflict and Revolt in the Name of Unity},
  author = {Schoots, Jonathan and Rohr, Benjamin and Prajda, Katalin and Padgett, John F.},
  year = 2020,

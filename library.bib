  author = {Giannetti, Biagio Fernando and Sevegnani, F{\'a}bio and Garc{\'i}a, Roberto R. M. and Agostinho, Feni and Almeida, Cec{\'i}lia M. V. B. and Coscieme, Luca and Liu, Genguyan and Lombardi, Ginevra Virginia},
  year = 2022,
  month = jan,
  journal = {Sustainability},
  volume = {14},

}

@inproceedings{Kroezen2022,
  title = {Divides {{Creeping In}}?: {{Relational Sensemaking}} and the {{Construction}} of {{Local Participation}} during the {{Energy Transition}} in {{De Ronde Venen}}},
  author = {Kroezen, Jochem and Werner, Mirjam},
  year = 2022,
  abstract = {While local collective action appears to become increasingly crucial in advanced democracies that grapple with wicked problems, many of the traditional structures that facilitated this have dwindled or appear to be missing while macro discourse provides fertile ground for divisiveness. Previous research on wicked problems has paid significant attention to macro discursive dynamics around national and global political action, but less to the micro dynamics of community action. In this paper, we examine how local relational sensemaking---the manner in which individuals come to understand their roles vis a vis other individual or collective bodies in a geographic community---evolves over time and in the context of understructured social spaces. To this end, we build on a deep, longitudinal case study of the energy transition in a Dutch municipality just south of Amsterdam. Following an initial analysis of 14 semi-structured interviews with members of various voluntary associations that emerged in this space and rich observations collected during 14+ months of action research, we present a preliminary process model that illustrates how local engagement with and collaboration on the issue evolved from (a) a relational vacuum to (b) a polarized plane and, ultimately, (c) a state of affirmative role transformation. A driving force in this process appeared to relate to how individuals struggle to find clear roles for themselves and evaluate the roles of other (collective) bodies. We observe how (a) individuals (and collective bodies) find themselves unintentionally drawn into, what they perceive as, vacant roles, (b) how the ambiguity and ambivalence that goes hand in hand with this process ultimately fuels divisiveness and (c) how divisiveness in turn can trigger more inclusive and dialogic organizing.},
  langid = {english},
  file = {/home/jules/Zotero/storage/68M5EPII/Kroezen and Werner (2022) Divides Creeping In Relational Sensemaking and t.pdf}
}


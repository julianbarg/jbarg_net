@article{Lamb2024,
  title = {The Carbon Dioxide Removal Gap},
  author = {Lamb, William F. and Gasser, Thomas and {Roman-Cuesta}, Rosa M. and Grassi, Giacomo and Gidden, Matthew J. and Powis, Carter M. and Geden, Oliver and Nemet, Gregory and Pratama, Yoga and Riahi, Keywan and Smith, Stephen M. and Steinhauser, Jan and Vaughan, Naomi E. and Smith, Harry B. and Minx, Jan C.},
  year = 2024,
  month = jun,
  journal = {Nature Climate Change},
  volume = {14},

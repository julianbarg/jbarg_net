@article{Gonzalez-Redin2019,
  title = {Exploring Sustainable Land Use in Forested Tropical Social-Ecological Systems: {{A}} Case-Study in the {{Wet Tropics}}},
  shorttitle = {Exploring Sustainable Land Use in Forested Tropical Social-Ecological Systems},
  author = {{Gonzalez-Redin}, Julen and Gordon, Iain J. and Hill, Rosemary and Polhill, J. Gary and Dawson, Terence P.},
  year = 2019,
  month = feb,
  journal = {Journal of Environmental Management},
  volume = {231},

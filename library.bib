@article{Oh2026,
  title = {Climate Science or Politics? {{Blurred}} Demarcation and Interplay during the {{Obama}} Administrations, 2009--2017},
  shorttitle = {Climate Science or Politics?},
  author = {Oh, Youngmin and Sonnenfeld, David A.},
  year = 2026,
  month = jun,
  journal = {Climate Policy},
  volume = {0},

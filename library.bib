  author = {Cavicchioli, Ricardo and Ripple, William J. and Timmis, Kenneth N. and Azam, Farooq and Bakken, Lars R. and Baylis, Matthew and Behrenfeld, Michael J. and Boetius, Antje and Boyd, Philip W. and Classen, Aim{\'e}e T. and Crowther, Thomas W. and Danovaro, Roberto and Foreman, Christine M. and Huisman, Jef and Hutchins, David A. and Jansson, Janet K. and Karl, David M. and Koskella, Britt and Mark Welch, David B. and Martiny, Jennifer B. H. and Moran, Mary Ann and Orphan, Victoria J. and Reay, David S. and Remais, Justin V. and Rich, Virginia I. and Singh, Brajesh K. and Stein, Lisa Y. and Stewart, Frank J. and Sullivan, Matthew B. and {van Oppen}, Madeleine J. H. and Weaver, Scott C. and Webb, Eric A. and Webster, Nicole S.},

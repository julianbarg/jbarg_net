  pages = {1891--1903},
  issn = {0025-1909, 1526-5501},
  doi = {10.1287/mnsc.1080.0927},
  url = {http://pubsonline.informs.org/doi/10.1287/mnsc.1080.0927},
  urldate = {2022-07-20},
  abstract = {In this paper, we explore how organizations influence the unethical behavior of their employees. Using a unique data set of over three million vehicle emissions tests, we find strong evidence of ethical spillovers from firms to individuals. When inspectors work across different organizations, they adjust the rate at which they pass vehicles to the norms of those with whom they work. These spillovers are strongest at large facilities and corporate chains, and weakest for the large-volume inspectors. These results are consistent with the economics literature on productivity spillovers from organizations and peers and suggest that managers can influence the ethics of employee behavior through both formal norms and incentives. The results also suggest that employees have persistent ethics that limit the magnitude of this influence. These results imply that if ethical conformity is important to the financial and legal health of the organization, managers must be vigilant in their hiring, training, and monitoring to ensure that employee behavior is consistent with firm objectives.},
  langid = {english},
  file = {/home/jules/Zotero/storage/3DNK2JG9/Pierce and Snyder (2008) Ethical Spillovers in Firms Evidence from Vehicle.pdf}
}


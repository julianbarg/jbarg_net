@article{Howard-Grenville2017,
  title = {"{{If Chemists Don}}'t {{Do It}}, {{Who Is Going To}}?" {{Peer}}-Driven {{Occupational Change}} and the {{Emergence}} of {{Green Chemistry}}},
  author = {{Howard-Grenville}, Jennifer and Nelson, Andrew J. and Earle, Andrew G. and Haack, Julie A. and Young, Douglas M.},

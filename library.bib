  author = {Kheshgi, H. S. and Flannery, B. P. and Hoffert, M. I. and Lapenis, A. G.},
  year = 1994,
  month = sep,
  journal = {Energy},
  volume = {19},
  number = {9},
  pages = {967--974},
  issn = {0360-5442},
  doi = {10.1016/0360-5442(94)90082-5},
  url = {https://www.sciencedirect.com/science/article/pii/0360544294900825},
  urldate = {2026-06-07},
  abstract = {We consider the relative effectiveness of engineered systems for collection and marine disposal of CO2 from fossil-fuel-fired power plants using comparisons of the trend with time of CO2 concentration in the atmosphere from systems with and without marine disposal. Since the retention time for CO2 increases rapidly with depth of disposal, from a few years in the mixed layer up to several centuries as the depth increases beyond 1000 m, deep oceans have been considered as potential storage sites for CO2. However, CO2 collection and disposal consumes energy and produces extra CO2. We show that some of this extra CO2 reaches the atmosphere, so that atmospheric concentrations from systems with marine disposal ultimately exceed those from systems without controls. In some circumstances, they do so rapidly, making marine disposal less favorable than direct atmospheric release. The Global Warming Potential (GWP) can be used to compare different systems, but results for GWP highlight the difficult issue of determining what time scales are important in considering options to reduce concerns about global warming.},
  file = {/home/jules/Zotero/storage/7IIK8YLC/Kheshgi et al. (1994) The effectiveness of marine CO2 disposal.pdf;/home/jules/Zotero/storage/VASCW7T9/0360544294900825.html}
}

@incollection{Kheshgi2003,
  title = {Evasion of {{CO2 Injected}} into the {{Ocean}} in the {{Context}} of {{CO2 Stabilization}}},
  booktitle = {Greenhouse {{Gas Control Technologies}} - 6th {{International Conference}}},
  author = {Kheshgi, Haroon S.},
  editor = {Gale, J. and Kaya, Y.},
  year = 2003,

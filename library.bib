  doi = {10.1002/(SICI)1097-4571(199009)41:6<391::AID-ASI1>3.0.CO;2-9},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/%28SICI%291097-4571%28199009%2941%3A6%3C391%3A%3AAID-ASI1%3E3.0.CO%3B2-9},
  urldate = {2023-04-25},
  abstract = {A new method for automatic indexing and retrieval is described. The approach is to take advantage of implicit higher-order structure in the association of terms with documents (``semantic structure'') in order to improve the detection of relevant documents on the basis of terms found in queries. The particular technique used is singular-value decomposition, in which a large term by document matrix is decomposed into a set of ca. 100 orthogonal factors from which the original matrix can be approximated by linear combination. Documents are represented by ca. 100 item vectors of factor weights. Queries are represented as pseudo-document vectors formed from weighted combinations of terms, and documents with supra-threshold cosine values are returned. Initial tests find this completely automatic method for retrieval to be promising. \copyright{} 1990 John Wiley \& Sons, Inc.},
  langid = {english},
  file = {/home/jules/Zotero/storage/ALIKVMRQ/Deerwester et al. (1990) Indexing by latent semantic analysis.pdf;/home/jules/Zotero/storage/L5YDWHZD/(SICI)1097-4571(199009)416391AID-ASI13.0.html}
}


@article{Fisar2024,
  title = {Reproducibility in {{Management Science}}},
  author = {Fi{\v s}ar, Milo{\v s} and Greiner, Ben and Huber, Christoph and Katok, Elena and Ozkes, Ali I.},
  year = 2024,
  month = mar,
  journal = {Management Science},
  volume = {70},
  number = {3},
  pages = {1343--1356},
  publisher = {INFORMS},
  issn = {0025-1909},

@article{Cooper2018,
  title = {Halo Effect or Fallen Angel Effect? {{Firm}} Value Consequences of Greenhouse Gas Emissions and Reputation for Corporate Social Responsibility},
  shorttitle = {Halo Effect or Fallen Angel Effect?},
  author = {Cooper, Sue A. and Raman, K.K. and Yin, Jennifer},
  year = 2018,

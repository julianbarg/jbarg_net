  file = {/home/jules/Zotero/storage/EDVP3N33/Attari et al. (2010) Public perceptions of energy consumption and savin.pdf;/home/jules/Zotero/storage/4DFNAKYE/16054.html}
}

@article{zotero-item-12718,

@misc{McKee2021,
  title = {Humans Perceive Warmth and Competence in Artificial Intelligence},
  author = {McKee, Kevin and Bai, Xuechunzi and Fiske, Susan},
  year = 2021,
  month = feb,
  publisher = {PsyArXiv},
  doi = {10.31234/osf.io/5ursp},
  url = {https://psyarxiv.com/5ursp/},
  urldate = {2023-04-15},
  abstract = {Artificial intelligence increasingly suffuses everyday life. However, people are frequently reluctant to interact with A.I. systems. This challenges both the deployment of beneficial A.I. technology and the development of deep learning systems that depend on humans for oversight, direction, and regulation. Nine behavioral studies (N = 3,300) demonstrate that social-cognitive processes guide human interactions across a diverse range of real-world A.I. systems. Across studies, perceived warmth and competence emerge prominently in participants' impressions of A.I. systems. Judgments of warmth and competence systematically depend on human-A.I. interdependence and autonomy. In particular, participants perceive systems that optimize interests aligned with human interests as warmer and systems that operate independently from human direction as more competent. Finally, a prisoner's dilemma game shows that warmth and competence judgments predict participants' willingness to cooperate with a deep-learning system. These results underscore the generality of intent detection to interactions with a broad array of algorithmic actors. Researchers and policymakers should carefully consider the degree and alignment of interdependence between humans and new artificial intelligence systems.},
  langid = {american},
  keywords = {AI ethics},
  file = {/home/jules/Zotero/storage/7STXHPY8/McKee et al. (2021) Humans perceive warmth and competence in artificia.pdf}
}


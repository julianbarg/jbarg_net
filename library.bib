@article{Hufen2016,
  title = {Cheat {{Electricity}}? {{The Political Economy}} of {{Green Electricity Delivery}} on the {{Dutch Market}} for {{Households}} and {{Small Business}}},
  shorttitle = {Cheat {{Electricity}}?},
  author = {Hufen, J.},
  year = 2016,
  month = dec,
  journal = {Sustainability},
  volume = {9},
  number = {1},
  pages = {16},
  issn = {2071-1050},
  doi = {10.3390/su9010016},
  url = {http://www.mdpi.com/2071-1050/9/1/16},
  urldate = {2022-07-20},
  abstract = {The European Commission's renewable energy directive introduced a market-based Guarantees of Origin (GO)-trade system that gives consumers the choice of buying ``real'' green energy. This has been successful, as the market share of Dutch households that buy green energy grew to 64\% in 2015. However, societal organizations are dissatisfied with the green energy offered, categorizing it as ``cheat'' electricity. This article aims to solve this riddle of a successful product created under the GO-trade system but also heavily criticized. Research reveals a lively marketplace with buyers eager to buy green energy and energy producers offering a wide range of labels. Marketplace mechanisms are strongly influenced by political choices, and financial support for energy suppliers makes green energy a credible option. Societal groups, however, argue that the information provided is incomplete and misleading, that buying green energy does not impact positively on greenhouse gas reduction, and that better information and structural reform are required. The GO-trade system is strongly influenced by member states' national energy politics. Societal organizations have helped to optimize the implementation of the GO-trade system in the Netherlands, but they are not expected to be able to support the creation of a level playing field in which an optimal GO-trade system will flourish.},
  langid = {english},
  file = {/home/jules/Zotero/storage/2J67GF9V/Hufen (2016) Cheat Electricity The Political Economy of Green.pdf}
}


@article{Chi2021,
  title = {Understanding {{Perceived Value}} and {{Purchase Intention}} toward {{Eco-Friendly Athleisure Apparel}}: {{Insights}} from {{U}}.{{S}}. {{Millennials}}},
  shorttitle = {Understanding {{Perceived Value}} and {{Purchase Intention}} toward {{Eco-Friendly Athleisure Apparel}}},
  author = {Chi, Ting and Ganak, Jessica and Summers, Lauren and Adesanya, Olabisi and McCoy, Lindsay and Liu, Hang and Tai, Yining},
  year = 2021,
  month = jul,
  journal = {Sustainability},

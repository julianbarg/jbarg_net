@article{deBree2020,
  title = {De- and {{Recoupling}} and {{Public Regulation}}},
  author = {{de Bree}, Martin and Stoopendaal, Annemiek},
  year = 2020,
  month = may,
  journal = {Organization Studies},
  volume = {41},
  number = {5},

  pages = {4774},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2071-1050},
  doi = {10.3390/su13094774},
  url = {https://www.mdpi.com/2071-1050/13/9/4774},
  urldate = {2026-07-18},
  abstract = {Voluntary carbon offsets (VCO) have been introduced as a means of compensating personal carbon emissions related to travelling. Purchases of VCO have remained low in the past, but might increase in the future due to rising awareness about climate change. VCO have been assumed to increase the acceptability of flying among eco-minded people. Therefore, VCO might not only be a tool to offset emissions but also to compensate for ``flight shame''. Much research has been carried out to detect VCO purchasers' motives, but none has explored the potential behavioral rebound effects of VCO with regard to flying. This article contributes to the debate by presenting a conceptual framework that was developed to investigate these rebound effects. First, we present the motives that travelers have for offsetting their flight emissions. These motives already indicate the possibility of a rebound effect. Second, we discuss several conceptual ideas which should be considered for the design of empirical studies. Overall, we argue that the use of VCO might lead to unintended carbon emissions; however, isolating the specific role of VCO remains a difficult task. Nevertheless, research on behavioral rebound effects is needed to clarify whether VCO counteract sustainability in the transport sector.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {behavior change,behavioral rebound effect,carbon offsets,flight emissions,flight shame,moral licensing,travel behavior,VCO},
  file = {/home/jules/Zotero/storage/5FP6BSMQ/Kerner and Brudermann (2021) I Believe I Can Fly—Conceptual Foundations for Beh.pdf}
}


@article{McCurdy2026,
  title = {Algorithmic Interception: Ad-Tech, Climate, and the Case of {{Canada}}'s Oil Sands},
  shorttitle = {Algorithmic Interception},
  author = {McCurdy, Patrick and Russill, Chris and Kliever, Jenny},
  year = 2026,
  month = jul,
  journal = {Environmental Research Letters},
  volume = {21},
  number = {13},
  pages = {134009},
  publisher = {IOP Publishing},
  issn = {1748-9326},
  doi = {10.1088/1748-9326/ae7b58},
  url = {https://doi.org/10.1088/1748-9326/ae7b58},
  urldate = {2026-08-20},
  abstract = {Oil and gas companies utilize artificial intelligence and advertising technology (ad-tech) to influence public discourse on climate and energy issues. Through contracts with public relations and advertising agencies, these companies access programmatic advertising: the automated generation, purchase, and display of digital ads in real time based on user queries and other targeting signals. These practices enable `algorithmic interception', the strategic positioning of narratives within algorithmically mediated information environments. This article examines algorithmic interception in the context of greenwashing by analyzing Google Search advertising strategies used by Canada's Pathways Alliance (now the Oil Sands Alliance). From a corpus of 1142 paid keywords and more than 15 000 organic keywords, we analyzed 1149 advertisements and 131 high-ranking organic results collected between 2022 and 2024. We found that Pathways Alliance purchased search terms related to climate policy and solutions, such as `carbon tax,' `climate action incentive,' and `net-zero,' with the result that its advertisements appeared alongside or above results for government programs, regulatory agencies, and climate science. In practice, this reshaped the online environment in which people sought information on climate questions and raised concerns about greenwashing. As one of the first studies to examine programmatic advertising in climate communication, we identify information patterns that are consistent with contemporary greenwashing as well as significant barriers to transparency and accountability inside these systems. There are significant information asymmetries created by the opacity of platforms such as Google, which withhold audience targeting and ad placement details from public scrutiny. As large language model--based search and generative engine optimization emerge as the next frontier for algorithmic interception, the need for independent tools to audit how climate narratives are surfaced will only intensify.},
  langid = {english},
  file = {/home/jules/Zotero/storage/HKYTGY4E/McCurdy et al. (2026) Algorithmic interception ad-tech, climate, and th.pdf}
}


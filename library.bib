  series = {Discourse, {{Meaning}}, and {{Networks}}: {{Advances}} in {{Socio-Semantic Analysis}}},
  volume = {78},
  pages = {101386},
  issn = {0304-422X},
  doi = {10.1016/j.poetic.2019.101386},
  url = {https://www.sciencedirect.com/science/article/pii/S0304422X18302821},
  urldate = {2024-10-09},
  abstract = {We analyze public-policy speeches in the Florentine Consulte e Pratiche, immediately prior to the Ciompi Revolt, for signs of elite factional conflict, in the context of self-proclaimed unity. We employ three statistical analyses of these speeches in Latin: namely, scatterplots of word frequencies, Wordfish scaling, and regressions on speech-similarities. Plus we employ two qualitative analyses: a case study of the speeches of Lapo da Castiglionchio, leader of the Parte Guelfa faction, and a close examination of the rhetoric of unity in three important sets of meetings. Our main finding is this: The runup to the Ciompi Revolt was crystalization of ``unity of citizens'' in the room of the Consulte e Pratiche and, among the same actors, crystallization of ``unity of Guelfs'' in the room of the Parte Guelfa, with a lack of recognition in the multivocal speeches in the former of the obvious contradiction with actions in the latter. In our opinion, the tragedy of ``the valiant failure of republicanism'' in Florence was that intense wishful yearning for unity in speech induced, under background conditions of deep social-class contestation about ``Who is Florence?,'' an intensification in action of the very revolutionary forces that it most desperately wanted to suppress.},
  file = {/home/jules/Zotero/storage/KJJ87SVY/Schoots et al. (2020) Conflict and revolt in the name of unity Florenti.pdf;/home/jules/Zotero/storage/FDW9RTYT/S0304422X18302821.html}
}


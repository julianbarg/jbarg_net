@article{Ostro2024,
  title = {Health Impact Assessment of {{PM2}}.5 from Uncovered Coal Trains in the {{San Francisco Bay Area}}: {{Implications}} for Global Exposures},
  shorttitle = {Health Impact Assessment of {{PM2}}.5 from Uncovered Coal Trains in the {{San Francisco Bay Area}}},

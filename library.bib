  isbn = {978-0-19-879205-5},
  langid = {english},
  file = {/home/jules/Zotero/storage/R6L8GG2D/Westphal and Park (2020) Symbolic Management of Process.pdf;/home/jules/Zotero/storage/VVGEX29C/Westphal and Park (2020) Symbolic Management of Process.pdf}

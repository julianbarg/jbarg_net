@article{Tiwari2026,
  title = {The Fossilized Pathways of Novel Technologies: How Carbon Capture, Conversion, and Utilization Is Poised to Reinforce Carbon Lock-In},
  shorttitle = {The Fossilized Pathways of Novel Technologies},
  author = {Tiwari, Shardul and Neville, Kate J. and Hoicka, Christina E.},
  year = 2026,
  month = sep,
  journal = {Climatic Change},
  volume = {179},
  number = {10},
  pages = {207},
  issn = {1573-1480},
  doi = {10.1007/s10584-026-04298-y},
  url = {https://doi.org/10.1007/s10584-026-04298-y},
  urldate = {2026-09-25},
  abstract = {There is growing anticipation about a new suite of lab-scale carbon-related technologies, described as carbon capture, conversion, and utilization (CCCU). Their development, proponents claim, could provide a route to recycle carbon. The process, where electricity produced through renewable sources could be used to capture CO2 and convert it to chemicals and fuels, would allow downstream industrial processes and energy systems to remain unchanged. We critically interrogate the development of CCCU to examine whether and how these technologies might disrupt or reinforce fossil fuel entrenchment, drawing on research on carbon lock-in. Carbon lock-in describes how interactions among infrastructures, technologies, institutions, actors, and norms constrain the rate of the phaseout---or the magnitude of the reduction---of fossil fuel use. We find that the development of CCCU technologies reinforces techno-enthusiasm for a growth-focused energy transition. We argue that such a value-chain-focused shift both obscures and reinforces three pathways of carbon lock-in: first, it perpetuates and helps grow carbon-based infrastructure, which limits durable transitions away from fossil fuels and delays change (infrastructure lock-in); second, it directs renewable energy expansion towards supporting carbon conversion, limiting broader economic transformations (economic lock-in); and third, it reinforces existing arrangements of corporate power (institutional lock-in). Our analysis reveals that if these technologies were deployed at scale, CCCU is poised to reinforce already powerful downstream industries and continue to concentrate corporate power. These developments could create new environmental harms. A critical carbon lock-in lens allows us to better identify and analyze the anticipated outcomes of advances in CCCU technologies.},
  langid = {english},
  keywords = {Carbon capture conversion and utilization,Carbon lock-in,Delay strategies,Energy transitions,Industrial power},
  file = {/home/jules/Zotero/storage/MJFB56YA/Tiwari et al. (2026) The fossilized pathways of novel technologies how.pdf}
}


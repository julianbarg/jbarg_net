@article{Lesser2007a,
  title = {Relationship between {{Funding Source}} and {{Conclusion}} among {{Nutrition-Related Scientific Articles}}},
  author = {Lesser, Lenard I. and Ebbeling, Cara B. and Goozner, Merrill and Wypij, David and Ludwig, David S.},
  year = 2007,

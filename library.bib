  url = {https://journals.aom.org/doi/full/10.5465/amr.1991.4279484},
  urldate = {2021-05-27},
  abstract = {Reviews indicate that the dominant perspective in the diffusion of innovation literature contains proinnovation biases which suggest that innovations and the diffusion of innovations will benefit adopters. As a result, it is difficult to either address or begin answering the questions: when and how do technically inefficient innovations diffuse? or when and how are technically efficient innovations rejected? This article has two goals: (1) to develop a typology that focuses attention on three less dominant perspectives that can be used to guide research on these questions and (2) to suggest how organizational scientists can develop more encompassing theories of innovation diffusion and rejection by using the theoretical tensions that exist between the dominant perspective and the three perspectives developed in this article. These resolutions are important because they indicate that processes which prompt the adoption of efficient innovations may coexist with processes that prompt the adoption of inefficient ones. Additionally, these resolutions inform research on the diffusion and rejection of many different types of innovations across varying contexts.},
  file = {/home/jules/Zotero/storage/MA3YECAZ/Abrahamson (1991) Managerial Fads and Fashions The Diffusion and Re.pdf;/home/jules/Zotero/storage/DGYWP5A4/amr.1991.html}
}

